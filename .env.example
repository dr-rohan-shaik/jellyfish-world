# Jellyfish World - Environment Configuration
# Optional: Bring-Your-Own-Key for AI responses (OpenAI-compatible endpoints)
# Works with OpenAI, Groq, NVIDIA NIM, Local LLMs (Ollama / vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct
AI_PROVIDER=none  # options: none (scripted offline), byok (OpenAI-compatible)

# Display preferences
REDUCED_MOTION=false
NO_COLOR=false
